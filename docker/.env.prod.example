# Скопируй в docker/.env.prod и заполни.
# Любая стойкая комбинация букв/цифр/спецсимволов > 16 знаков — норм пароль для dev'a;
# для прода лучше openssl rand -base64 24.

# === Домен и контакт для Let's Encrypt ===
DOMAIN=onnxi.example.com
ACME_EMAIL=you@example.com
TZ=Europe/Moscow

# === GitHub Container Registry (где CI публикует образы) ===
# Owner репозитория — должно совпадать с GITHUB_REPOSITORY_OWNER на GitHub.
GITHUB_REPO_OWNER=crazys0k
IMAGE_TAG=latest

# === Postgres ===
POSTGRES_USER=onnxi
POSTGRES_PASSWORD=replace-me-strong
POSTGRES_DB=onnxi

# === MinIO ===
MINIO_ROOT_USER=onnxi-minio
MINIO_ROOT_PASSWORD=replace-me-strong

# === Keycloak admin + клиентский секрет ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me-strong
KEYCLOAK_CLIENT_SECRET=replace-me-after-realm-import

# === Grafana (профиль observability) ===
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=replace-me-strong

# === SMTP для notification-service ===
# Если есть свой smtp (например Yandex/Gmail App password) — заполните.
# Иначе сервис всё равно поднимется, но письма не отправятся.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_EMAIL_FROM=onnxi@example.com

# === Telegram (опционально) ===
TELEGRAM_BOT_TOKEN=
