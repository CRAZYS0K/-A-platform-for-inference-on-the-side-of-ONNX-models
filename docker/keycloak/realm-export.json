{
  "realm": "onnxi",
  "enabled": true,
  "displayName": "ONNXI",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 1800,
  "accessCodeLifespanLogin": 1800,
  "roles": {
    "realm": [
      { "name": "CLIENT", "description": "End user of the platform" },
      { "name": "ADMIN", "description": "Administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "onnxi-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost/login/oauth2/code/keycloak",
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost/##https://localhost##http://localhost:8080"
      }
    },
    {
      "clientId": "onnxi-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    }
  ]
}
