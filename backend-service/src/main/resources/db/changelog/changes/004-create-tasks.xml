<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="004-create-inference-tasks" author="sokolov">
        <createTable tableName="inference_tasks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tasks_owner" references="users(id)"/>
            </column>
            <column name="model_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tasks_model" references="models(id)"/>
            </column>
            <column name="dataset_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tasks_dataset" references="datasets(id)"/>
            </column>
            <column name="status" type="VARCHAR(16)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="progress_pct" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="result_s3_key" type="VARCHAR(512)"/>
            <column name="accuracy" type="NUMERIC(6, 4)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="inference_tasks" indexName="idx_tasks_owner_created">
            <column name="owner_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-task-events" author="sokolov">
        <createTable tableName="task_events">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_events_task" references="inference_tasks(id)"/>
            </column>
            <column name="event_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT"/>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="task_events" indexName="idx_events_task">
            <column name="task_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
